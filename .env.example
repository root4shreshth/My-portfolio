# Google Gemini API key for the "Ask the system" assistant
# Create one at https://aistudio.google.com/apikey (the project needs billing/credits)
# Add it on Netlify: Site configuration → Environment variables
GEMINI_API_KEY=your-gemini-key-here

# Optional: override the model (defaults to gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# Canonical site URL used for SEO metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=https://hype4shreshth.in
